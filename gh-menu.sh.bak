#!/bin/bash
# GitHub Interactive Menu - Semua operasi GitHub via gh CLI
# Penulis: Hermes Agent (deku)
# Pakai: ./gh-menu.sh atau bash ~/Github/gh-menu.sh

# Warna untuk output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Cek autentikasi GitHub
check_auth() {
    echo -e "${BLUE}Memeriksa status autentikasi GitHub...${NC}"
    if gh auth status 2>/dev/null; then
        echo -e "${GREEN}GitHub sudah terautentikasi!${NC}"
    else
        echo -e "${RED}Gagal memeriksa autentikasi. Pastikan 'gh auth login' sudah dijalankan.${NC}"
    fi
    echo ""
}

# Dapatkan repo yang dipilih pengguna
get_repo() {
    echo -e "${CYAN}Daftar repositori Anda:${NC}"
    gh repo list --limit 50 --json name,owner,visibility -q '.[] | "\(.owner.login)/\(.name) (\(.visibility))"' | head -30
    echo ""
    read -p "Masukkan nama repo (owner/repo) atau tekan ENTER untuk repo saat ini: " repo_input
    if [ -z "$repo_input" ]; then
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            repo_input=$(gh repo view --json nameWithOwner -q '.nameWithOwner')
            echo -e "${GREEN}Menggunakan repo aktif: $repo_input${NC}"
        else
            echo -e "${RED}Tidak ada repo yang aktif. Pilih repo terlebih dahulu.${NC}"
            return 1
        fi
    fi
    REPO_NAME="$repo_input"
    export REPO_NAME
}

# === Repositori ===
list_repos() {
    echo -e "${BLUE}Mengunduh daftar repositori...${NC}"
    gh repo list --json name,owner,visibility,defaultBranchRef,pushedAt,createdAt,isFork \
        --jq '.[] | select(.visibility == "public" or .owner.login == "wahyuajismustofa30") | "\(.owner.login)/\(.name) | \(.visibility) | \(.defaultBranchRef.name) | \(.pushedAt[:10])"' | column -t -s'|'
    echo ""
}

clone_repo() {
    echo -e "${CYAN}Contoh: owner/repo${NC}"
    read -p "Masukkan URL atau nama repo yang ingin clone: " clone_url
    read -p "Lokasi tujuan (kosong = current dir): " clone_dir
    if [ -z "$clone_dir" ]; then
        gh repo clone "$clone_url"
    else
        gh repo clone "$clone_url" "$clone_dir"
    fi
    echo -e "${GREEN}Clone selesai!${NC}"
}

create_repo() {
    read -p "Nama repo baru: " new_repo
    read -p "Deskripsi (opsional): " desc
    read -p "Public (Y) atau Private (N): " pub
    read -p "Inisialisasi README? (y/N): " init_readme
    read -p "Lisensi? (e.g., MIT, ISC, GPL-3.0 - kosong = tidak ada): " license
    
    echo -e "${BLUE}Membuat repo $new_repo...${NC}"
    visibility="private"
    [[ "$pub" =~ ^[Yy]$ ]] && visibility="public"
    
    if [ -n "$license" ]; then
        gh repo create "$new_repo" --description "$desc" --license "$license" --visibility "$visibility"
    elif [[ "$init_readme" =~ ^[Yy]$ ]]; then
        gh repo create "$new_repo" --description "$desc" --add-readme --visibility "$visibility"
    else
        gh repo create "$new_repo" --description "$desc" --visibility "$visibility"
    fi
    echo -e "${GREEN}Repo dibuat!${NC}"
}

delete_repo() {
    read -p "Masukkan nama repo yang ingin hapus (owner/repo): " del_repo
    read -p "Yakin hapus $del_repo? (ketik YANG BENAR untuk konfirmasi): " confirm
    actual_name=$(gh repo view --json nameWithOwner -q '.nameWithOwner' "$del_repo" 2>/dev/null)
    if [ "$confirm" == "$actual_name" ]; then
        gh repo delete "$del_repo" --yes
        echo -e "${GREEN}Repo dihapus!${NC}"
    else
        echo -e "${RED}Membatalkan.${NC}"
    fi
}

# === Branch ===
list_branches() {
    get_repo || return
    cd /tmp
    git clone --depth 1 --single-branch --branch main "https://github.com/$REPO_NAME.git" repo_temp 2>/dev/null || \
    git clone --depth 1 --single-branch --branch master "https://github.com/$REPO_NAME.git" repo_temp 2>/dev/null || true
    if [ -d repo_temp ]; then
        cd repo_temp
        git branch -a
        cd .. && rm -rf repo_temp
    fi
    cd - >/dev/null
}

create_branch() {
    read -p "Nama branch baru: " branch_name
    git switch -c "$branch_name" 2>/dev/null || git checkout -b "$branch_name"
    echo -e "${GREEN}Branch $branch_name dibuat dan aktif!${NC}"
}

switch_branch() {
    read -p "Nama branch yang ingin switch: " branch_name
    git switch "$branch_name" 2>/dev/null || git checkout "$branch_name"
    echo -e "${GREEN}Berpindah ke $branch_name${NC}"
}

delete_branch() {
    read -p "Nama branch yang ingin hapus: " branch_name
    git branch -D "$branch_name"
    echo -e "${GREEN}Branch dihapus!${NC}"
}

# === Commit & Push ===
commit_changes() {
    echo -e "${CYAN}Status perubahan:${NC}"
    git status --short
    echo ""
    read -p "Message commit: " commit_msg
    git add . && git commit -m "$commit_msg"
    echo -e "${GREEN}Commit selesai!${NC}"
}

push_branch() {
    branch=$(git branch --show-current)
    echo -e "${BLUE}Mengpush branch '$branch' ke origin...${NC}"
    git push -u origin "$branch"
    echo -e "${GREEN}Push selesai!${NC}"
}

# === Pull Request ===
list_prs() {
    echo -e "${CYAN}Daftar PR Anda (wahyuajismustofa30):${NC}"
    # Minta pilih repo
    echo ""
    echo "Pilih repo untuk melihat PRs:"
    echo "1. Repo aktif (jika ada git repo)"
    count=1
    repos=$(gh repo list wahyuajismustofa30 --json name -q '.[].name' 2>/dev/null)
    declare -a repo_arr
    while IFS= read -r r; do
        repo_arr+=("$r")
        echo "$count. $r"
        ((count++))
    done <<< "$repos"
    read -p "Pilih nomor repo (atau tekan ENTER untuk batal): " choice
    echo ""
    if [ "$choice" -eq 1 ] && [ "$choice" -le "${#repo_arr[@]}" ]; then
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            gh pr list --author wahyuajismustofa30 --state all --json number,title,state,mergedAt \
                -q '.[] | "#\(.number) [\(.state)] \(.title)"'
        else
            echo -e "${RED}Tidak ada repo yang aktif.${NC}"
        fi
    elif [ "$choice" -ge 2 ] && [ "$choice" -le "$count" ]; then
        selected_repo="${repo_arr[$((choice-1))]}"
        gh -R "$selected_repo" pr list --author wahyuajismustofa30 --state all --json number,title,state,mergedAt \
            -q '.[] | "#\(.number) [\(.state)] \(.title)"'
    fi
    echo ""
}

view_pr() {
    echo -e "${CYAN}Daftar PR terbuka di repo ini:${NC}"
    gh pr list --state open --json number,title,author,createdAt -q '.[] | "#\(.number) \(.title) by \(.author.login)"'
    echo ""
    read -p "Masukkan nomor PR (atau tekan ENTER): " pr_num
    if [ -n "$pr_num" ]; then
        gh pr view "$pr_num" --web
    else
        echo "Tidak ada PR yang ditampilkan."
    fi
}

create_pr() {
    branch=$(git branch --show-current)
    if [ "$branch" == "main" ] || [ "$branch" == "master" ]; then
        echo -e "${RED}Tidak bisa buat PR dari branch utama.${NC}"
        return
    fi
    read -p "Judul PR: " title
    read -p "Deskripsi (opsional): " body
    read -p "Target branch (default: main): " target
    target=${target:-main}
    
    if [ -n "$body" ]; then
        gh pr create --title "$title" --body "$body" --base "$target"
    else
        gh pr create --title "$title" --base "$target"
    fi
    echo -e "${GREEN}PR dibuat!${NC}"
}

view_pr_checks() {
    echo -e "${CYAN}CI/checks untuk semua PR Anda:${NC}"
    echo "PR | Status | Checks"
    echo "---|--------|-------"
    for pr in $(gh pr list --author wahyuajismustofa30 --state open --json number -q '.[].number'); do
        status=$(gh pr checks "$pr" --json state -q '.state' 2>/dev/null || echo "unknown")
        echo "#$pr | $status"
    done
}

merge_pr() {
    echo -e "${CYAN}PR yang siap digabungkan:${NC}"
    gh pr list --state open --json number,title,status -q '.[] | select(.status == "success") | "#\(.number) \(.title)"'
    echo ""
    read -p "Nomor PR yang ingin merge: " pr_num
    read -p "Method merge (merge/squash/rebase): " method
    method=${method:-merge}
    gh pr merge "$pr_num" --$method --auto 2>/dev/null || gh pr merge "$pr_num" --$method
    echo -e "${GREEN}PR #$pr_num digabungkan!${NC}"
}

# === Issues ===
list_issues() {
    echo -e "${CYAN}Pilih state issues:${NC}"
    echo "1. semua (all)"
    echo "2. terbuka (open)"
    echo "3. tertutup (closed)"
    read -p "Pilih 1-3 (default: 1): " choice
    choice=${choice:-1}
    case $choice in
        1) state="all" ;;
        2) state="open" ;;
        3) state="closed" ;;
        *) state="all" ;;
    esac
    echo ""
    echo -e "${CYAN}Issues Anda (${state}):${NC}"
    gh issue list --author wahyuajismustofa30 --state "$state" --json number,title,state,labels,assignees \
        -q '.[] | "#\(.number) [\(.state)] \(.title) \(.labels[0]?.name // "") \(.assignees[0]?.login // "")"'
}

create_issue() {
    read -p "Judul issue: " title
    read -p "Deskripsi: " body
    gh issue create --title "$title" --body "$body"
    echo -e "${GREEN}Issue dibuat!${NC}"
}

close_issue() {
    echo -e "${CYAN}Issues terbuka:${NC}"
    gh issue list --state open --json number,title -q '.[] | "#\(.number) \(.title)"'
    echo ""
    read -p "Nomor issue yang ingin tutup: " issue_num
    issue_title=$(gh issue view "$issue_num" --json title -q '.title' 2>/dev/null)
    gh issue close "$issue_num"
    echo -e "${GREEN}Issue #$issue_num ditutup: '$issue_title'${NC}"
}

# === Search ===
search_code() {
    read -p "Kata kunci pencarian kode: " query
    read -p "Path penelururan (kosong = semua): " path
    if [ -n "$path" ]; then
        gh search code "$query" --path="$path"
    else
        gh search code "$query"
    fi
}

# === Actions ===
list_workflows() {
    get_repo || return
    echo -e "${CYAN}Workflow Actions di repo ini:${NC}"
    gh api repos/$REPO_NAME/actions/workflows -q '.workflows[] | "\(.name) (\(.path))"'
}

run_workflow() {
    get_repo || return
    echo -e "${CYAN}Workflow yang tersedia:${NC}"
    gh api repos/$REPO_NAME/actions/workflows -q '.workflows[] | "\(.id) - \(.name)"'
    echo ""
    read -p "Workflow ID atau nama: " workflow
    read -p "Branch (default: main): " ref
    ref=${ref:-main}
    gh run create "$workflow" --ref "$ref" --repo "$REPO_NAME"
    echo -e "${GREEN}Workflow dijalankan!${NC}"
}

view_runs() {
    echo -e "${CYAN}Action runs terbaru:${NC}"
    gh run list --limit 10
}

# === Releases ===
create_release() {
    read -p "Tag version (misal: v1.0.0): " tag
    read -p "Judul release (kosong = auto): " title
    read -p "Deskripsi: " notes
    read -p "Target branch (default: main): " ref
    ref=${ref:-main}
    gh release create "$tag" --title "$title" --notes "$notes" "$ref"
    echo -e "${GREEN}Release dibuat!${NC}"
}

list_releases() {
    echo -e "${CYAN}Daftar release:${NC}"
    gh release list
}

# === Info Umum ===
show_info() {
    echo -e "${CYAN}Informasi akun GitHub:${NC}"
    gh api user -q '"Login: \(.login)\nName: \(.name)\nPublic repo: \(.public_repos)\nFollowers: \(.followers)\nFollowing: \(.following)"'
    echo ""
    echo -e "${CYAN}Status autentikasi:${NC}"
    gh auth status
}

show_help() {
    echo -e "${GREEN}=== GitHub Interactive Menu ===${NC}"
    echo "Menu ini menyediakan semua operasi GitHub via gh CLI."
    echo "Pastikan repository yang Anda kerjakan aktif (git remote -v)."
    echo "Gunakan perintah: bash ~/Github/gh-menu.sh"
    echo ""
}

# === Main Menu ===
main_menu() {
    while true; do
        echo ""
        echo -e "${BLUE}=======================================${NC}"
        echo -e "${BLUE}   Menu Utama - GitHub Operations    ${NC}"
        echo -e "${BLUE}=======================================${NC}"
        echo ""
        echo " 1.  Cek Autentikasi GitHub"
        echo " 2.  Daftar Semua Repository"
        echo " 3.  Clone Repository Baru"
        echo " 4.  Buat Repository Baru"
        echo " 5.  Hapus Repository"
        echo " 6.  Daftar Branch di Repo"
        echo " 7.  Buat Branch Baru"
        echo " 8.  Switch/Sendiri Branch"
        echo " 9.  Commit & Push"
        echo "10.  Daftar PR Saya"
        echo "11.  Buat Pull Request"
        echo "12.  Review/Merge PR"
        echo "13.  Daftar Issues Saya"
        echo "14.  Buat Issue Baru"
        echo "15.  Tutup Issue"
        echo "16.  Search Kode/Issue"
        echo "17.  List & Run Actions"
        echo "18.  Kelola Release"
        echo "19.  Informasi Akun"
        echo "20.  Bantuan/Tutorials"
        echo " 0.  Keluar"
        echo ""
        read -p "Pilih menu (0-20): " choice
        
        case $choice in
            1) check_auth ;;
            2) list_repos ;;
            3) clone_repo ;;
            4) create_repo ;;
            5) delete_repo ;;
            6) get_repo && list_branches ;;
            7) get_repo && create_branch ;;
            8) switch_branch ;;
            9) commit_changes && push_branch ;;
            10) list_prs ;;
            11) create_pr ;;
            12) view_pr_checks || merge_pr ;;
            13) list_issues ;;
            14) create_issue ;;
            15) close_issue ;;
            16) search_code ;;
            17) list_workflows || run_workflow || view_runs ;;
            18) create_release || list_releases ;;
            19) show_info ;;
            20) show_help ;;
            0) echo -e "${GREEN}Terima kasih! Sampai jumpa.${NC}"; return 0 ;;
            *) echo -e "${RED}Pilihan tidak valid. Coba lagi.${NC}" ;;
        esac
    done
}

# Jalankan
show_help
main_menu